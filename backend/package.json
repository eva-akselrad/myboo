{
  "name": "myboo-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "test:e2e": "node test/e2e.mjs",
    "db:local": "wrangler d1 execute myboo --local --file=schema.sql",
    "db:remote": "wrangler d1 execute myboo --remote --file=schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
