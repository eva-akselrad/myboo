{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "myboo-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "myboo",
      // Replace after running: wrangler d1 create myboo
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ]
  // Secret (not committed): wrangler secret put FCM_SERVICE_ACCOUNT
}
