{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "myboo-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "observability": { "enabled": true },
  "triggers": { "crons": ["*/5 * * * *"] },
  "assets": { "directory": "./public" },
  "routes": [{ "pattern": "myboo.evaakselrad.com", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "myboo",
      "database_id": "3311ae9c-a8ce-436e-9c6b-d3cae4cbe493"
    }
  ],
  // Cloudflare Email Service: sender domain (evaakselrad.com) is onboarded for Email Sending.
  "send_email": [{ "name": "EMAIL" }],
  "vars": { "FROM_EMAIL": "myboo@evaakselrad.com" }
}
